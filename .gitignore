# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Environment — never commit real secrets
.env
.env.local
# ...but DO commit the templates. This file previously listed .env.example and
# .env.railway.example as ignore entries, so a fresh clone had no template to
# copy from. Those entries are gone; these negations are belt-and-braces in
# case the pattern above is ever widened to `.env*`.
# Verify with: git check-ignore -v .env.example  (should print nothing)
!.env.example
!.env.railway.example

# Raw / processed crawl data (large, re-generated by ingest script)
data/raw/
data/processed/

# NOTE: data/chroma/ is intentionally tracked so the pre-built vector store
# is available to Railway (which has no persistent volumes on the free plan).
# Re-run scripts/ingest.py locally and commit the updated data/chroma/ folder
# whenever the knowledge base changes.

# Logs
logs/
*.log

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Test
.pytest_cache/
.coverage
htmlcov/

# Docker
*.pid
